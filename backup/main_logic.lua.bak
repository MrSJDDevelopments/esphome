-- Replace "top" with the side your monitor is on (e.g., "left", "right", "back")
local monitor = peripheral.wrap("top")

-- List of colours to cycle through
local colorList = {
    colors.red, colors.orange, colors.yellow, colors.lime, 
    colors.blue, colors.purple, colors.magenta, colors.white
}

monitor.clear()
local i = 1

-- Repeat until the program is manually terminated (Ctrl+T)
while true do
    -- Reset cursor to top-left
    monitor.setCursorPos(1, 1)
    
    -- Set the next colour in the list
    monitor.setTextColor(colorList[i])
    
    -- Print the message
    monitor.write("Hello World!")
    
    -- Cycle index: 1 -> 2 -> ... -> 8 -> 1
    i = i % #colorList + 1
    
    -- Delay so you can see the color change
    sleep(0.5)
end